@model ProfileVm
@{ ViewData["Title"] = "Profile"; }
<h1>Your profile</h1><form method="post" enctype="multipart/form-data" class="panel mt-4">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="UserId" type="hidden" /><input asp-for="Email" type="hidden" /><input asp-for="Role" type="hidden" /><div class="row"><div class="col-md-6"><label asp-for="FirstName"></label><input asp-for="FirstName" class="form-control mb-3" /></div><div class="col-md-6"><label asp-for="LastName"></label><input asp-for="LastName" class="form-control mb-3" /></div></div><label asp-for="Phone"></label><input asp-for="Phone" class="form-control mb-3" /><label asp-for="DateOfBirth"></label><input asp-for="DateOfBirth" class="form-control mb-3" /><label asp-for="ProfilePictureUrl"></label><input asp-for="ProfilePictureUrl" class="form-control mb-3" /><label asp-for="ProfilePicture">Upload profile image</label><input asp-for="ProfilePicture" accept="image/*" class="form-control mb-3" /><button class="btn btn-lime">Save profile</button></form>
