@model List<ApiEnrolment>
@{ ViewData["Title"] = "My events"; }
<h1>My events</h1><div class="panel table-responsive"><table class="table"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Status</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.EventName</td><td>@item.EventDate.ToLocalTime().ToString("dd MMM yyyy")</td><td>@item.CategoryName</td><td><span class="badge status-confirmed">@item.EnrolmentStatus</span></td></tr>}</tbody></table></div>
