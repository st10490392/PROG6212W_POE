@model List<ApiEvent>
@{ ViewData["Title"] = "Explore events"; }
<div class="d-flex justify-content-between align-items-end mb-4"><div><p class="eyebrow">The calendar</p><h1>Upcoming events</h1></div><span class="text-muted">@Model.Count events</span></div>
<form method="get" class="panel mb-4"><div class="row g-2 align-items-end"><div class="col-md-5"><label>Event type</label><select name="eventTypeId" class="form-select"><option value="">All types</option>@foreach (var type in (List<ApiEventType>)ViewBag.EventTypes) { <option value="@type.EventTypeId" selected="@(ViewBag.EventTypeId == type.EventTypeId)">@type.Name</option> }</select></div><div class="col-md-5"><label>Date</label><input name="date" type="date" value="@ViewBag.Date?.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-md-2"><button class="btn btn-dark w-100">Filter</button></div></div></form>
<div class="row g-4">
@foreach (var item in Model) { <div class="col-md-6 col-lg-4"><div class="event-card h-100"><div class="event-stripe"></div><div class="p-4"><span class="badge bg-light text-dark">@item.EventType</span><h2 class="h4 mt-3">@item.Name</h2><p class="text-muted">@item.Description</p><div class="small text-muted mb-3">@item.EventDate.ToLocalTime().ToString("ddd, dd MMM yyyy · HH:mm")<br />@item.Location · @item.DistanceKm km</div><a class="btn btn-dark w-100" asp-action="Details" asp-route-id="@item.EventId">View event</a></div></div></div> }
</div>
@if (!Model.Any()) { <div class="empty-state"><h2>No events yet</h2><p>Check back soon for the next start line.</p></div> }
