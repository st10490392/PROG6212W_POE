@model List<ApiResult>
@{ ViewData["Title"] = "Results"; var item = ViewBag.Event as ApiEvent; var enrolments = (List<ApiEnrolment>)ViewBag.Enrolments; }
<p class="eyebrow">Organiser hub</p><h1>@item?.Name results</h1>
<div class="panel mb-4"><h3>Capture result</h3><form method="post" asp-action="AddResult"><input type="hidden" name="eventId" value="@item?.EventId" /><select name="EnrolmentId" class="form-select mb-2">@foreach (var enrolment in enrolments) { <option value="@enrolment.EnrolmentId">@enrolment.ParticipantName · @enrolment.CategoryName</option> }</select><div class="row"><div class="col"><input name="FinishTime" type="time" step="1" class="form-control" /></div><div class="col"><input name="FinishingPosition" type="number" min="1" class="form-control" placeholder="Position" /></div></div><button class="btn btn-lime mt-3">Record result</button></form></div>
<div class="panel table-responsive"><table class="table"><thead><tr><th>Position</th><th>Event</th><th>Finish time</th></tr></thead><tbody>@foreach (var result in Model.OrderBy(x => x.FinishingPosition)) { <tr><td>@result.FinishingPosition</td><td>@result.EventName · @result.CategoryName</td><td>@result.FinishTime</td></tr>}</tbody></table></div>
