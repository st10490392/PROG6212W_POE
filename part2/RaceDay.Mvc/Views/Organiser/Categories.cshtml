@model List<ApiCategory>
@{ ViewData["Title"] = "Categories"; var item = ViewBag.Event as ApiEvent; }
<p class="eyebrow">Organiser hub</p><h1>@item?.Name categories</h1>
<div class="panel mb-4"><h3>Add category</h3><form method="post" asp-action="AddCategory"><input type="hidden" name="EventId" value="@item?.EventId" /><div class="row g-2"><div class="col-md-3"><select name="CategoryType" class="form-select"><option>Age</option><option>Distance</option></select></div><div class="col-md-3"><input name="Name" class="form-control" placeholder="Category name" required /></div><div class="col-md-2"><input name="MinAge" type="number" class="form-control" placeholder="Min age" /></div><div class="col-md-2"><input name="MaxAge" type="number" class="form-control" placeholder="Max age" /></div><div class="col-md-2"><input name="DistanceKm" type="number" step=".01" class="form-control" placeholder="Distance km" /></div></div><button class="btn btn-lime mt-3">Add category</button></form></div>
<div class="panel table-responsive"><table class="table"><thead><tr><th>Name</th><th>Type</th><th>Bounds</th><th></th></tr></thead><tbody>@foreach (var category in Model) { <tr><td>@category.Name</td><td>@category.CategoryType</td><td>@(category.CategoryType == "Age" ? $"{category.MinAge}-{category.MaxAge} years" : $"{category.DistanceKm} km")</td><td class="text-end"><a class="btn btn-sm btn-outline-dark" asp-action="EditCategory" asp-route-id="@category.CategoryId" asp-route-eventId="@item?.EventId">Edit</a> <form method="post" asp-action="DeleteCategory" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@category.CategoryId" /><input type="hidden" name="eventId" value="@item?.EventId" /><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr> }</tbody></table></div>
