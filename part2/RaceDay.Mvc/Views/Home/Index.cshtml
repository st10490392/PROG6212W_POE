@{
    ViewData["Title"] = "Find your finish";
}
<section class="hero rounded-4 p-5 mb-5">
  <div class="col-lg-7">
    <p class="eyebrow">South Africa's event day platform</p>
    <h1 class="display-3 fw-bold">Find your finish line.</h1>
    <p class="lead text-white-50">Discover road races, walks and cycling events. Organise the day. Own the moment.</p>
    <a class="btn btn-lime btn-lg me-2" asp-controller="Events" asp-action="Index">Explore events</a>
    <a class="btn btn-outline-light btn-lg" asp-controller="Auth" asp-action="Register">Get started</a>
  </div>
</section>
<div class="row g-4">
  <div class="col-md-4"><div class="feature-card"><strong>01</strong><h3>Discover</h3><p>Browse upcoming events and choose your category.</p></div></div>
  <div class="col-md-4"><div class="feature-card"><strong>02</strong><h3>Show up</h3><p>Keep every enrolment and event detail in one place.</p></div></div>
  <div class="col-md-4"><div class="feature-card"><strong>03</strong><h3>Celebrate</h3><p>Track results and share your race-day story.</p></div></div>
</div>
