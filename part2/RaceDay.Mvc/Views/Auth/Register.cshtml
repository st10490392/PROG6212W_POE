@model RegisterVm
@{ ViewData["Title"] = "Join RaceDay"; }
<div class="auth-card mx-auto"><p class="eyebrow">Your next start</p><h1>Create account</h1>
<form method="post">
 @Html.AntiForgeryToken()
 <div asp-validation-summary="ModelOnly" class="text-danger"></div>
 <div class="row"><div class="col-md-6"><label asp-for="FirstName"></label><input asp-for="FirstName" class="form-control mb-3" /></div><div class="col-md-6"><label asp-for="LastName"></label><input asp-for="LastName" class="form-control mb-3" /></div></div>
 <label asp-for="Email"></label><input asp-for="Email" class="form-control mb-3" />
 <label asp-for="Password"></label><input asp-for="Password" class="form-control mb-3" />
 <label asp-for="Role">I am joining as</label><select asp-for="Role" class="form-select mb-3"><option>Participant</option><option>Organiser</option></select>
 <label asp-for="Phone"></label><input asp-for="Phone" class="form-control mb-3" />
 <button class="btn btn-lime w-100">Create account</button>
</form></div>
