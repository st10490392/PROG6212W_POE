@model LoginVm
@{ ViewData["Title"] = "Sign in"; }
<div class="auth-card mx-auto"><p class="eyebrow">Welcome back</p><h1>Sign in</h1>
<form method="post">
 @Html.AntiForgeryToken()
 <div asp-validation-summary="ModelOnly" class="text-danger"></div>
 <label asp-for="Email"></label><input asp-for="Email" class="form-control mb-3" />
 <label asp-for="Password"></label><input asp-for="Password" class="form-control mb-3" />
 <button class="btn btn-lime w-100">Sign in</button>
</form>
<p class="mt-3 text-muted">New to RaceDay? <a asp-action="Register">Create an account</a>.</p></div>
