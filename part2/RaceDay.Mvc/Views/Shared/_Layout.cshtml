<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - RaceDay</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-night">
  <div class="container">
    <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">RACEDAY<span class="text-lime">.</span></a>
    <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
    <div id="nav" class="collapse navbar-collapse">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">Explore events</a></li>
        @if (Context.Session.GetInt32("UserId") is not null && Context.Session.GetString("Role") == "Organiser")
        {
          <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Index">Organiser hub</a></li>
          <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Events">Manage events</a></li>
        }
        @if (Context.Session.GetInt32("UserId") is not null && Context.Session.GetString("Role") == "Participant")
        {
          <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My events</a></li>
          <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="MyResults">My results</a></li>
          <li class="nav-item"><a class="nav-link" asp-controller="Participant" asp-action="Profile">Profile</a></li>
        }
      </ul>
      <div class="d-flex align-items-center gap-3">
        @if (Context.Session.GetInt32("UserId") is null)
        {
          <a class="btn btn-outline-light btn-sm" asp-controller="Auth" asp-action="Login">Sign in</a>
          <a class="btn btn-lime btn-sm" asp-controller="Auth" asp-action="Register">Join RaceDay</a>
        }
        else
        {
          <span class="small text-white-50">@Context.Session.GetString("DisplayName")</span>
          <form asp-controller="Auth" asp-action="Logout" method="post"><button class="btn btn-outline-light btn-sm">Sign out</button></form>
        }
      </div>
    </div>
  </div>
</nav>
<main class="container py-4">
  @if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
  @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
  @RenderBody()
</main>
<footer class="border-top py-4 mt-5"><div class="container text-muted small">RaceDay &middot; Run your day.</div></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
